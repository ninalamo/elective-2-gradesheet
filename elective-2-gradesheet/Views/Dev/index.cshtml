@{
    ViewData["Title"] = "Development Reflection";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient text-white text-center py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h1 class="mb-0">
                        <i class="fas fa-code me-3"></i>
                        Development Reflection & Journey
                    </h1>
                    <p class="mb-0 mt-2 opacity-75">Reflections on improving code organization, user experience, and technical challenges faced during the project</p>
                </div>
                <div class="card-body p-5">

                    <!-- Introduction Section -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-4">
                            <i class="fas fa-lightbulb me-2"></i>
                            Project Overview
                        </h2>
                        <div class="bg-light p-4 rounded-3 mb-4">
                            <p class="lead mb-3">
                                This assignment revolved around enhancing an existing ASP.NET Core grade management application by refactoring its code and improving its functionality. The focus was on optimizing the code structure, improving maintainability, and enhancing the user experience.
                            </p>
                            <p class="mb-0">
                                Throughout this project, I focused on restructuring JavaScript code, implementing partial views for reuse, and improving the navigation and overall flow of the user interface. These changes not only improved the efficiency of the application but also made the codebase much cleaner and easier to manage.
                            </p>
                        </div>
                    </section>

                    <!-- Technical Challenges Section -->
                    <section class="mb-5">
                        <h2 class="text-success mb-4">
                            <i class="fas fa-cogs me-2"></i>
                            Technical Challenges & Solutions
                        </h2>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card h-100 border-success">
                                    <div class="card-header bg-success text-white">
                                        <h5 class="mb-0"><i class="fas fa-js-square me-2"></i>JavaScript Modularization</h5>
                                    </div>
                                    <div class="card-body">
                                        <p><strong>Challenge:</strong> The project had inline JavaScript embedded directly in the `.cshtml` views, which made debugging and maintaining the code difficult, violating the principle of separation of concerns.</p>
                                        <p><strong>Solution:</strong> I moved all JavaScript into separate files located in <code>wwwroot/js/views/</code>, making the code more modular, reusable, and easier to manage.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card h-100 border-info">
                                    <div class="card-header bg-info text-white">
                                        <h5 class="mb-0"><i class="fas fa-puzzle-piece me-2"></i>Partial View Implementation</h5>
                                    </div>
                                    <div class="card-body">
                                        <p><strong>Challenge:</strong> Repeated HTML structures and complex modals made the views hard to maintain and update.</p>
                                        <p><strong>Solution:</strong> I extracted reusable elements such as the activity modal and student profile forms into partial views (<code>_EditActivityModalPartial</code> and <code>_StudentProfileFormsPartial</code>), which allowed for cleaner and more maintainable code.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Learning Outcomes Section -->
                    <section class="mb-5">
                        <h2 class="text-warning mb-4">
                            <i class="fas fa-graduation-cap me-2"></i>
                            Key Learning Outcomes
                        </h2>

                        <div class="accordion" id="learningAccordion">
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="headingOne">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                        <i class="fas fa-layer-group me-2"></i>Architecture & Organization
                                    </button>
                                </h3>
                                <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#learningAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li><strong>Separation of Concerns:</strong> Gained a deeper understanding of keeping server-side logic, JavaScript, and HTML properly separated to improve project scalability and ease of maintenance.</li>
                                            <li><strong>Modular Design:</strong> Implemented partial views to reduce code duplication and encourage reusability across different views.</li>
                                            <li><strong>File Organization:</strong> The importance of properly organizing static assets, such as JavaScript files and CSS, to maintain a clean and efficient project structure.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h3 class="accordion-header" id="headingTwo">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                        <i class="fas fa-user-friends me-2"></i>User Experience Enhancement
                                    </button>
                                </h3>
                                <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#learningAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li><strong>Tooltips & Navigation:</strong> Learned how small improvements like tooltips and intuitive navigation could greatly improve the user experience.</li>
                                            <li><strong>Routing Configuration:</strong> Realized the importance of configuring default routing to streamline user navigation and application flow.</li>
                                            <li><strong>Filter Functionality:</strong> Implemented intuitive filter options, allowing users to reset filters and manage data more effectively.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h3 class="accordion-header" id="headingThree">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                        <i class="fas fa-tools me-2"></i>Technical Implementation
                                    </button>
                                </h3>
                                <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#learningAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li><strong>ASP.NET Core Razor:</strong> Gained hands-on experience with partial view rendering, model binding, and managing view data.</li>
                                            <li><strong>Bootstrap Integration:</strong> Effectively utilized Bootstrap 5 components to ensure a responsive and interactive design.</li>
                                            <li><strong>JavaScript Module Pattern:</strong> Adopted the module pattern for better separation of client-side logic and integration with the server-side rendered content.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Technical Implementation Details -->
                    <section class="mb-5">
                        <h2 class="text-danger mb-4">
                            <i class="fas fa-code-branch me-2"></i>
                            Implementation Highlights
                        </h2>

                        <div class="row g-4">
                            <div class="col-12">
                                <div class="bg-dark text-light p-4 rounded-3">
                                    <h5 class="text-warning mb-3"><i class="fas fa-file-code me-2"></i>Code Structure Improvements</h5>
                                    <ul class="mb-0">
                                        <li><strong>JavaScript Modularization:</strong> Moved code into separate files like <code>index.js</code>, <code>records.js</code>, <code>studentProfile.js</code></li>
                                        <li><strong>Partial Views:</strong> Implemented reusable partial views, including <code>_EditActivityModalPartial.cshtml</code> and <code>_StudentProfileFormsPartial.cshtml</code></li>
                                        <li><strong>Enhanced Navigation:</strong> Added navigation features such as "Back" buttons, tooltips, and other UI improvements</li>
                                        <li><strong>Filter Functionality:</strong> Implemented a reset button for filters to provide users with more control over displayed records</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Reflection & Future Improvements -->
                    <section class="mb-5">
                        <h2 class="text-info mb-4">
                            <i class="fas fa-thinking-head me-2"></i>
                            Personal Reflection
                        </h2>

                        <div class="bg-info bg-opacity-10 p-4 rounded-3 border-start border-5 border-info">
                            <h5 class="text-info mb-3">What Went Well</h5>
                            <p>
                                This project provided an excellent opportunity to improve my understanding of ASP.NET Core architecture. I particularly benefited from breaking down large view files into manageable components, making the project easier to maintain. The JavaScript modularization proved to be a major improvement in terms of maintainability and reusability.
                            </p>

                            <h5 class="text-info mb-3 mt-4">Challenges Encountered</h5>
                            <p>
                                The biggest challenge was ensuring that all functionality continued to work after restructuring. From ensuring the correct data binding to maintaining modal interactions, I had to pay attention to every detail to make sure everything continued to function as intended.
                            </p>

                            <h5 class="text-info mb-3 mt-4">Future Improvements</h5>
                            <ul class="mb-0">
                                <li>Further improve client-side functionality with state management</li>
                                <li>Implement automated testing to ensure stability</li>
                                <li>Consider building a Web API for better separation of concerns and flexibility</li>
                            </ul>
                        </div>
                    </section>

                    <!-- Conclusion -->
                    <section class="mb-4">
                        <h2 class="text-secondary mb-4">
                            <i class="fas fa-flag-checkered me-2"></i>
                            Conclusion
                        </h2>
                        <div class="alert alert-success" role="alert">
                            <h5 class="alert-heading"><i class="fas fa-check-circle me-2"></i>Mission Accomplished!</h5>
                            <p class="mb-0">
                                This refactoring exercise demonstrated the importance of clean code architecture, modularity, and user-centered design. The improvements made will ensure the application is easier to maintain, scale, and improve in the future.
                            </p>
                        </div>
                    </section>

                </div>

                <div class="card-footer bg-light text-center py-4">
                    <p class="text-muted mb-2">
                        <i class="fas fa-calendar-alt me-2"></i>
                        Development completed: <strong>August 2025</strong>
                    </p>
                    <div class="mt-3">
                        <a asp-controller="Home" asp-action="Records" class="btn btn-primary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Application
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-purple {
        color: #6f42c1 !important;
    }
</style>
