@model elective_2_gradesheet.Models.BulkGradingViewModel

@{
    ViewData["Title"] = "Bulk Grading";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>@ViewData["Title"]</h1>
            <p class="lead">Bulk grade student GitHub repository submissions</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Select Section and Activity</h5>
        </div>
        <div class="card-body">
            <form id="bulkGradingForm">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="sectionSelect">Section:</label>
                            <select id="sectionSelect" class="form-select" required>
                                <option value="">Select a Section</option>
                                @if (Model.Sections != null)
                                {
                                    @foreach (var sectionItem in Model.Sections)
                                    {
                                        <option value="@(sectionItem.Value)">@(sectionItem.Text)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="activitySelect">Activity/Assignment:</label>
                            <select id="activitySelect" class="form-select" required disabled>
                                <option value="">Select an Activity</option>
                            </select>
                            <small class="text-muted">Select a section first</small>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <button type="button" id="loadStudentsBtn" class="btn btn-primary" disabled>
                            <i class="fas fa-users"></i> Load Students
                        </button>
                        <div id="activityInfo" class="mt-2" style="display: none;">
                            <div class="alert alert-info">
                                <strong>Activity Info:</strong>
                                <span id="activityInfoText"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Students Table -->
    <div id="studentsSection" class="card mt-4" style="display: none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Students</h5>
            <div>
                <div class="form-check form-switch me-3">
                    <input class="form-check-input" type="checkbox" id="showNonZeroGrades">
                    <label class="form-check-label" for="showNonZeroGrades">
                        Show students with non-zero grades
                    </label>
                </div>
                <button type="button" id="processSelectedBtn" class="btn btn-success" disabled>
                    <i class="fas fa-play"></i> Process Selected Students
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <button type="button" id="selectAllBtn" class="btn btn-outline-primary btn-sm me-2">
                    <i class="fas fa-check-square"></i> Select All
                </button>
                <button type="button" id="deselectAllBtn" class="btn btn-outline-secondary btn-sm me-2">
                    <i class="far fa-square"></i> Deselect All
                </button>
                <span class="text-muted">Selected: <span id="selectedCount">0</span> students</span>
            </div>
            
            <div class="table-responsive">
                <table id="studentsTable" class="table table-striped">
                    <thead>
                        <tr>
                            <th width="40">Select</th>
                            <th class="sortable" data-sort="name" style="cursor: pointer;">
                                Student Name <i class="fas fa-sort"></i>
                            </th>
                            <th class="sortable" data-sort="status" style="cursor: pointer;">
                                Current Status <i class="fas fa-sort"></i>
                            </th>
                            <th class="sortable" data-sort="points" style="cursor: pointer;">
                                Current Points <i class="fas fa-sort"></i>
                            </th>
                            <th width="200">GitHub Repository</th>
                            <th class="sortable" data-sort="notes" style="cursor: pointer;">
                                Notes <i class="fas fa-sort"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="studentsTableBody">
                        <!-- Dynamic content will be loaded here -->
                    </tbody>
                </table>
            </div>
            
            <div class="mt-3">
                <small class="text-muted">
                    <i class="fas fa-info-circle"></i>
                    By default, students with non-zero grades and "Turned In" status are unselected. You can manually select/deselect students as needed.
                    <br>
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Note:</strong> Processing will clone repositories, scan for code patterns, and score against the rubric.
                </small>
            </div>
        </div>
    </div>

    <!-- Progress Section -->
    <div id="progressSection" class="card mt-4" style="display: none;">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-spinner fa-spin"></i> Processing Students
            </h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <div id="overallProgress" class="progress">
                    <div class="progress-bar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
                </div>
                <small class="text-muted mt-1">Processing <span id="currentStudentName"></span>...</small>
            </div>
            
            <div class="alert alert-info">
                <strong>Current Step:</strong> <span id="currentStep">Starting...</span><br>
                <strong>Repository:</strong> <span id="currentRepository">-</span><br>
                <strong>Progress:</strong> <span id="progressText">0 / 0 students</span>
            </div>
            
            <div id="progressLog" class="border rounded p-3" style="max-height: 300px; overflow-y: auto; background-color: #f8f9fa;">
                <!-- Progress log will be added here -->
            </div>
        </div>
    </div>

    <!-- Preview Section -->
    <div id="previewSection" class="card mt-4" style="display: none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Preview Changes</h5>
            <div>
                <button type="button" id="approveAllBtn" class="btn btn-outline-success btn-sm me-2">
                    <i class="fas fa-check"></i> Approve All
                </button>
                <button type="button" id="rejectAllBtn" class="btn btn-outline-danger btn-sm me-2">
                    <i class="fas fa-times"></i> Reject All
                </button>
                <button type="button" id="saveChangesBtn" class="btn btn-primary" disabled>
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Review Required:</strong> Please review and approve the changes below before saving to the database.
                Items requiring approval are marked with a warning icon.
            </div>
            
            <div class="table-responsive">
                <table id="previewTable" class="table table-striped">
                    <thead>
                        <tr>
                            <th width="60">Approve</th>
                            <th>Student</th>
                            <th>Action</th>
                            <th>New Points</th>
                            <th>New Status</th>
                            <th>Current</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody id="previewTableBody">
                        <!-- Preview items will be loaded here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Final Results Section -->
    <div id="finalResultsSection" class="card mt-4" style="display: none;">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-check-circle text-success"></i> Processing Complete
            </h5>
        </div>
        <div class="card-body">
            <div id="finalMessage" class="alert alert-success">
                <!-- Final success message -->
            </div>
        </div>
    </div>
</div>

<!-- Loading Modal -->
<div class="modal fade" id="loadingModal" tabindex="-1" aria-labelledby="loadingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-body text-center">
                <div class="spinner-border" role="status" aria-hidden="true"></div>
                <div class="mt-2">Processing...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .repo-input {
            font-size: 0.875rem;
        }
        .repo-input:invalid {
            border-color: #dc3545;
        }
        .repo-input:valid:not(:placeholder-shown) {
            border-color: #28a745;
        }
        .repo-input:focus {
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }
        .table th {
            position: sticky;
            top: 0;
            background-color: #fff;
            z-index: 10;
        }
    </style>
    <script>
        $(document).ready(function() {
            let currentSectionId = null;
            let currentActivityId = null;
            let studentsData = [];
            let currentSessionId = null;
            let progressInterval = null;

            // Section selection handler
            $('#sectionSelect').on('change', function() {
                const sectionId = $(this).val();
                currentSectionId = sectionId;
                
                if (sectionId) {
                    loadActivityTemplates(sectionId);
                    $('#activitySelect').prop('disabled', false);
                } else {
                    $('#activitySelect').empty().append('<option value="">Select an Activity</option>').prop('disabled', true);
                    $('#loadStudentsBtn').prop('disabled', true);
                    hideAllSections();
                }
            });

            // Activity selection handler
            $('#activitySelect').on('change', function() {
                const activityId = $(this).val();
                currentActivityId = activityId;
                
                if (activityId && currentSectionId) {
                    const selectedOption = $(this).find('option:selected');
                    const activityName = selectedOption.text();
                    const maxPoints = selectedOption.data('maxpoints');
                    const hasRubric = selectedOption.data('hasrubric');
                    
                    $('#activityInfoText').html(`
                        <strong>${activityName}</strong> (Max Points: ${maxPoints})
                        ${hasRubric ? '<span class="badge bg-success">Has Rubric</span>' : '<span class="badge bg-danger">No Rubric - Cannot Process</span>'}
                    `);
                    $('#activityInfo').show();
                    
                    if (hasRubric) {
                        $('#loadStudentsBtn').prop('disabled', false);
                        $('#noRubricAlert').hide();
                    } else {
                        $('#loadStudentsBtn').prop('disabled', true);
                        hideAllSections();
                        showNoRubricAlert();
                    }
                } else {
                    $('#activityInfo').hide();
                    $('#loadStudentsBtn').prop('disabled', true);
                    hideAllSections();
                }
            });

            // Load students button
            $('#loadStudentsBtn').on('change', function() {
                const showNonZero = $(this).is(':checked');
                if (currentSectionId && currentActivityId) {
                    loadStudents(currentSectionId, currentActivityId, showNonZero);
                }
            });

            $('#loadStudentsBtn').on('click', function() {
                const showNonZero = $('#showNonZeroGrades').is(':checked');
                if (currentSectionId && currentActivityId) {
                    loadStudents(currentSectionId, currentActivityId, showNonZero);
                }
            });

            // Show/hide students with non-zero grades
            $('#showNonZeroGrades').on('change', function() {
                const showNonZero = $(this).is(':checked');
                filterStudentVisibility(showNonZero);
            });

            // Select/deselect all buttons
            $('#selectAllBtn').on('click', function() {
                $('.student-checkbox:visible').prop('checked', true).trigger('change');
            });

            $('#deselectAllBtn').on('click', function() {
                $('.student-checkbox').prop('checked', false).trigger('change');
            });

            // Process selected button
            $('#processSelectedBtn').on('click', function() {
                processSelectedStudents();
            });

            // Preview section buttons
            $('#approveAllBtn').on('click', function() {
                $('.approval-checkbox').prop('checked', true).trigger('change');
            });

            $('#rejectAllBtn').on('click', function() {
                $('.approval-checkbox').prop('checked', false).trigger('change');
            });

            $('#saveChangesBtn').on('click', function() {
                saveBulkGradingResults();
            });

            // Table sorting functionality
            $('.sortable').on('click', function() {
                const sortBy = $(this).data('sort');
                sortStudentsTable(sortBy);
            });

            // Load activity templates for section
            function loadActivityTemplates(sectionId) {
                $.get('/Home/GetActivityTemplates', { sectionId: sectionId }, function(response) {
                    if (response.success) {
                        const select = $('#activitySelect');
                        select.empty().append('<option value="">Select an Activity</option>');
                        
                        response.data.forEach(function(activity) {
                            select.append($('<option></option>')
                                .attr('value', activity.id)
                                .attr('data-maxpoints', activity.maxPoints)
                                .attr('data-hasrubric', activity.hasRubric)
                                .text(`${activity.name} (${activity.period}) - ${activity.maxPoints}pts`));
                        });
                    } else {
                        alert('Error loading activities: ' + response.message);
                    }
                }).fail(function() {
                    alert('Failed to load activities');
                });
            }

            // Load students using enhanced bulk grading service
            function loadStudents(sectionId, activityId, showNonZeroGrades = false) {
                showLoading();
                
                window.location.href = `/Home/BulkGrading?sectionId=${sectionId}&activityTemplateId=${activityId}&showNonZeroGrades=${showNonZeroGrades}`;
            }

            // Filter student visibility based on grade status
            function filterStudentVisibility(showNonZero) {
                $('.student-row').each(function() {
                    const hasNonZeroGrade = $(this).data('has-nonzero-grade');
                    if (showNonZero || !hasNonZeroGrade) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
                updateSelectedCount();
            }

            // Update selected count display
            function updateSelectedCount() {
                const selectedCount = $('.student-checkbox:visible:checked').length;
                const totalVisible = $('.student-checkbox:visible').length;
                $('#selectedCount').text(`${selectedCount}`);
                updateProcessButtonState(); // Also check repository validation
            }

            // Table sorting functionality
            let currentSort = { column: null, direction: 'asc' };
            
            function sortStudentsTable(sortBy) {
                const tbody = $('#studentsTableBody');
                const rows = tbody.find('tr.student-row').toArray();
                
                // Determine sort direction
                if (currentSort.column === sortBy) {
                    currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
                } else {
                    currentSort.column = sortBy;
                    currentSort.direction = 'asc';
                }
                
                // Update sort icons
                $('.sortable i').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
                const currentHeader = $(`.sortable[data-sort="${sortBy}"] i`);
                currentHeader.removeClass('fa-sort').addClass(currentSort.direction === 'asc' ? 'fa-sort-up' : 'fa-sort-down');
                
                // Sort rows
                rows.sort((a, b) => {
                    let aVal, bVal;
                    const aRow = $(a);
                    const bRow = $(b);
                    
                    switch (sortBy) {
                        case 'name':
                            aVal = aRow.find('td:nth-child(2)').text().trim();
                            bVal = bRow.find('td:nth-child(2)').text().trim();
                            break;
                        case 'status':
                            aVal = aRow.find('td:nth-child(3) .badge').text().trim();
                            bVal = bRow.find('td:nth-child(3) .badge').text().trim();
                            break;
                        case 'points':
                            aVal = parseFloat(aRow.find('td:nth-child(4)').text().trim()) || 0;
                            bVal = parseFloat(bRow.find('td:nth-child(4)').text().trim()) || 0;
                            break;
                        case 'notes':
                            aVal = aRow.find('td:nth-child(6)').text().trim();
                            bVal = bRow.find('td:nth-child(6)').text().trim();
                            break;
                        default:
                            return 0;
                    }
                    
                    let comparison = 0;
                    if (typeof aVal === 'string' && typeof bVal === 'string') {
                        comparison = aVal.localeCompare(bVal);
                    } else {
                        comparison = aVal - bVal;
                    }
                    
                    return currentSort.direction === 'asc' ? comparison : -comparison;
                });
                
                // Re-append sorted rows
                tbody.empty();
                rows.forEach(row => tbody.append(row));
            }

            // Process selected students
            function processSelectedStudents() {
                const selectedStudents = [];
                const missingRepos = [];
                
                $('.student-checkbox:checked').each(function() {
                    const studentId = parseInt($(this).data('student-id'));
                    const repoUrl = $(`.repo-input[data-student-id="${studentId}"]`).val().trim();
                    const studentName = $(this).closest('tr').find('td:nth-child(2)').text().trim();
                    
                    if (!repoUrl) {
                        missingRepos.push(studentName);
                    } else {
                        selectedStudents.push({
                            studentId: studentId,
                            repositoryUrl: repoUrl
                        });
                    }
                });

                if (selectedStudents.length === 0) {
                    alert('No students selected for processing.');
                    return;
                }
                
                if (missingRepos.length > 0) {
                    const proceed = confirm(`The following students have no repository URL specified:\n\n${missingRepos.join('\n')}\n\nDo you want to continue processing only the students with repository URLs?`);
                    if (!proceed) {
                        return;
                    }
                }

                const request = {
                    activityTemplateId: currentActivityId,
                    sectionId: currentSectionId,
                    selectedStudents: selectedStudents,
                    showNonZeroGrades: $('#showNonZeroGrades').is(':checked')
                };

                $.ajax({
                    url: '/Home/StartBulkProcessing',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request),
                    success: function(response) {
                        if (response.success) {
                            currentSessionId = response.sessionId;
                            showProgressSection();
                            startProgressPolling();
                        } else {
                            alert('Error starting bulk processing: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('Failed to start bulk processing');
                    }
                });
            }

            // Start polling for progress updates
            function startProgressPolling() {
                if (progressInterval) {
                    clearInterval(progressInterval);
                }

                progressInterval = setInterval(function() {
                    if (currentSessionId) {
                        updateProgress();
                    }
                }, 1000); // Poll every second
            }

            // Update progress display
            function updateProgress() {
                $.get('/Home/GetBulkProcessingProgress', { sessionId: currentSessionId }, function(response) {
                    if (response.success) {
                        const progress = response.progress;
                        const percentage = Math.round(progress.progressPercentage);
                        
                        $('#overallProgress .progress-bar')
                            .css('width', percentage + '%')
                            .attr('aria-valuenow', percentage)
                            .text(percentage + '%');
                        
                        $('#currentStudentName').text(progress.studentName || 'Unknown');
                        $('#currentStep').text(progress.currentStep || 'Processing...');
                        $('#currentRepository').text(progress.repositoryUrl || '-');
                        $('#progressText').text(`${progress.processedCount} / ${progress.totalCount} students`);
                        
                        // Add to progress log
                        if (progress.currentStep && progress.studentName) {
                            const logEntry = `[${new Date().toLocaleTimeString()}] ${progress.studentName}: ${progress.currentStep}`;
                            const logDiv = $('<div>').addClass('small text-muted').text(logEntry);
                            $('#progressLog').append(logDiv);
                            // Auto-scroll to bottom
                            $('#progressLog').scrollTop($('#progressLog')[0].scrollHeight);
                        }
                        
                        if (progress.isComplete) {
                            clearInterval(progressInterval);
                            progressInterval = null;
                            
                            if (progress.hasError) {
                                alert('Processing completed with errors: ' + progress.errorMessage);
                            } else {
                                // Load preview
                                setTimeout(loadPreview, 1000);
                            }
                        }
                    }
                });
            }

            // Load preview of changes
            function loadPreview() {
                $.get('/Home/GetBulkProcessingPreview', { sessionId: currentSessionId }, function(response) {
                    if (response.success) {
                        populatePreviewTable(response.previewItems);
                        showPreviewSection();
                    } else {
                        alert('Error loading preview: ' + response.message);
                    }
                });
            }

            // Populate preview table
            function populatePreviewTable(previewItems) {
                const tbody = $('#previewTableBody');
                tbody.empty();
                
                previewItems.forEach(function(item) {
                    const requiresApproval = item.requiresApproval;
                    const actionText = item.isNew ? 'New Submission' : 'Update Existing';
                    const actionClass = item.isNew ? 'badge bg-success' : 'badge bg-warning';
                    const currentText = item.isNew ? '-' : `${item.currentPoints}pts, ${item.currentStatus}`;
                    
                    const row = $(`
                        <tr data-student-id="${item.studentId}">
                            <td>
                                ${requiresApproval ? 
                                    `<input type="checkbox" class="form-check-input approval-checkbox" data-student-id="${item.studentId}" ${item.isApproved ? 'checked' : ''}>`
                                    : '<i class="fas fa-check text-success"></i>'}
                            </td>
                            <td>${item.studentName}</td>
                            <td><span class="${actionClass}">${actionText}</span></td>
                            <td>${item.newPoints}</td>
                            <td>${item.newStatus}</td>
                            <td><small class="text-muted">${currentText}</small></td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="showScoringDetails('${item.studentId}')">
                                    <i class="fas fa-info-circle"></i> Details
                                </button>
                            </td>
                        </tr>
                    `);
                    tbody.append(row);
                });
                
                // Update save button state
                updateSaveButtonState();
                
                // Bind approval checkbox events
                $('.approval-checkbox').on('change', updateSaveButtonState);
            }

            // Update save button state based on approvals
            function updateSaveButtonState() {
                const totalRequiringApproval = $('.approval-checkbox').length;
                const approvedCount = $('.approval-checkbox:checked').length;
                const canSave = totalRequiringApproval === 0 || approvedCount > 0;
                $('#saveChangesBtn').prop('disabled', !canSave);
            }

            // Save bulk grading results
            function saveBulkGradingResults() {
                // Update approval statuses
                $('.approval-checkbox').each(function() {
                    const studentId = $(this).data('student-id');
                    const isApproved = $(this).is(':checked');
                    
                    $.ajax({
                        url: '/Home/UpdateApprovalStatus',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ sessionId: currentSessionId, studentId: studentId, isApproved: isApproved }),
                        async: false // Ensure all updates complete before saving
                    });
                });
                
                // Save results
                $.ajax({
                    url: '/Home/SaveBulkGradingResults',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ sessionId: currentSessionId }),
                    success: function(response) {
                        if (response.success) {
                            showFinalResults(response.message);
                        } else {
                            alert('Error saving results: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('Failed to save results');
                    }
                });
            }

            // Show no rubric alert
            function showNoRubricAlert() {
                if ($('#noRubricAlert').length === 0) {
                    $('#activityInfo').after(`
                        <div id="noRubricAlert" class="alert alert-warning mt-2">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Cannot Process:</strong> This activity has no rubric defined. 
                            Bulk grading requires activities to have rubrics for automatic scoring.
                            <br><small>Please select an activity that has a rubric, or add a rubric to this activity first.</small>
                        </div>
                    `);
                } else {
                    $('#noRubricAlert').show();
                }
            }

            // Show final results
            function showFinalResults(message) {
                hideAllSections();
                $('#finalMessage').text(message);
                $('#finalResultsSection').show();
            }

            // Section visibility helper functions
            function showProgressSection() {
                hideAllSections();
                $('#progressSection').show();
                // Clear previous progress log
                $('#progressLog').empty();
            }

            function showPreviewSection() {
                $('#progressSection').hide();
                $('#previewSection').show();
            }

            function hideAllSections() {
                $('#studentsSection').hide();
                $('#progressSection').hide();
                $('#previewSection').hide();
                $('#finalResultsSection').hide();
                $('#noRubricAlert').hide();
            }

            function showLoading() {
                $('#loadingModal').modal('show');
            }

            function hideLoading() {
                $('#loadingModal').modal('hide');
            }
            
            // Initialize page if we have students data from server
            @if (Model.Students != null && Model.Students.Any())
            {
                @:// Populate the students table with server data
                @:const students = @Html.Raw(Json.Serialize(Model.Students));
                @:populateStudentsTable(students);
                @:$('#studentsSection').show();
                @:
                @:// Set the show non-zero grades checkbox state
                @:$('#showNonZeroGrades').prop('checked', @Model.ShowNonZeroGrades.ToString().ToLower());
            }

            // Populate students table with server data
            function populateStudentsTable(students) {
                const tbody = $('#studentsTableBody');
                tbody.empty();
                
                students.forEach(function(student) {
                    const isVisible = student.isVisible;
                    const displayStyle = isVisible ? '' : 'style="display: none;"';
                    const hasNonZeroGrade = student.hasNonZeroGrade;
                    const notes = hasNonZeroGrade ? 'Has non-zero grade' : (student.hasTurnedIn ? 'Turned in' : 'No submission');
                    
                    const row = $(`
                        <tr class="student-row" data-student-id="${student.studentId}" data-has-nonzero-grade="${hasNonZeroGrade}" ${displayStyle}>
                            <td>
                                <input type="checkbox" class="form-check-input student-checkbox" 
                                       data-student-id="${student.studentId}" 
                                       ${student.isSelected ? 'checked' : ''}>
                            </td>
                            <td>${student.studentName}</td>
                            <td>
                                <span class="badge ${getStatusBadgeClass(student.currentStatus)}">
                                    ${student.currentStatus || 'No Status'}
                                </span>
                            </td>
                            <td>${student.currentPoints || 0}</td>
                            <td>
                                <input type="url" class="form-control form-control-sm repo-input" 
                                       data-student-id="${student.studentId}" 
                                       placeholder="https://github.com/user/repo"
                                       value="${student.repositoryUrl || ''}">
                                <small class="text-muted">GitHub repository URL</small>
                            </td>
                            <td><small class="text-muted">${notes}</small></td>
                        </tr>
                    `);
                    tbody.append(row);
                });
                
                // Bind checkbox change events
                $('.student-checkbox').on('change', updateSelectedCount);
                updateSelectedCount();
                
                // Bind repository URL validation events
                $('.repo-input').on('input', function() {
                    validateRepositoryUrl($(this));
                }).on('blur', function() {
                    // Auto-save repository URL when user leaves the field
                    const input = $(this);
                    if (input.val().trim() && input[0].checkValidity()) {
                        const studentId = input.data('student-id');
                        const repoUrl = input.val().trim();
                        // Could save to database here if needed
                    }
                });
                
                // Bind sorting events to headers (in case they weren't bound yet)
                $('.sortable').off('click').on('click', function() {
                    const sortBy = $(this).data('sort');
                    sortStudentsTable(sortBy);
                });
            }

            // Get status badge class
            function getStatusBadgeClass(status) {
                if (!status) return 'bg-secondary';
                switch(status.toLowerCase()) {
                    case 'turned in': return 'bg-success';
                    case 'completed': return 'bg-success';
                    case 'not turned in': return 'bg-danger';
                    case 'missing': return 'bg-secondary';
                    default: return 'bg-secondary';
                }
            }

            // Repository URL validation function
            function validateRepositoryUrl(input) {
                const url = input.val().trim();
                const isValid = url === '' || (url.includes('github.com') && url.startsWith('https://'));
                
                input.removeClass('is-valid is-invalid');
                if (url) {
                    input.addClass(isValid ? 'is-valid' : 'is-invalid');
                }
                
                // Update process button state
                updateProcessButtonState();
            }
            
            // Update process button state based on repository URLs
            function updateProcessButtonState() {
                const selectedStudents = $('.student-checkbox:checked');
                let hasValidRepos = true;
                let selectedCount = 0;
                
                selectedStudents.each(function() {
                    const studentId = $(this).data('student-id');
                    const repoInput = $(`.repo-input[data-student-id="${studentId}"]`);
                    const repoUrl = repoInput.val().trim();
                    
                    selectedCount++;
                    if (!repoUrl || !repoInput[0].checkValidity()) {
                        hasValidRepos = false;
                    }
                });
                
                $('#processSelectedBtn').prop('disabled', selectedCount === 0 || !hasValidRepos);
            }

            // Global function for showing scoring details (called from preview table)
            window.showScoringDetails = function(studentId) {
                // This would show a modal with detailed scoring information
                // For now, we'll just show an alert - you can implement a proper modal later
                alert('Scoring details for student ID: ' + studentId + '\n\nThis would show detailed rubric scoring information.');
            };
            
        });
    </script>
