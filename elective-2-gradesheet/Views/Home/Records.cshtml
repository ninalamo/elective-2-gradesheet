@using elective_2_gradesheet.Data.Entities
@using elective_2_gradesheet.Helpers
@model RecordsViewModel

@{
    ViewData["Title"] = "All Grade Records";
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary text-center"><i class="fas fa-database me-2"></i> All Grade Records</h2>

    <div class="card shadow-sm mb-4 rounded-lg">
        <div class="card-header text-white py-2 rounded-top-lg" style="background-color: #03A9F4;">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i> Filter Records</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Records" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Search by Name/Activity:</label>
                        <input type="text" name="searchString" class="form-control rounded-md" value="@Model.CurrentSearch" placeholder="Student name or activity..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Filter by Section:</label>
                        <select name="sectionId" asp-items="Model.Sections" class="form-control rounded-md">
                            <option value="">All Sections</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Filter by Period:</label>
                        <select name="period" asp-items="Html.GetEnumSelectList<GradingPeriod>()" class="form-control rounded-md">
                            <option value="">All Periods</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm">
                            <i class="fas fa-search me-1"></i> Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.StudentGroups.Any())
    {
        <div class="card shadow-sm rounded-lg">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="text-white" style="background-color: #36454F;">
                        <tr>
                            <th class="ps-3">Student</th>
                            <th>Student Number</th>
                            <th>Section</th>
                            <th>Total Activities</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var studentGroup in Model.StudentGroups)
                        {
                            <tr class="clickable-row" style="cursor: pointer;">
                                <td class="ps-3">
                                    <a asp-action="StudentProfile" asp-route-id="@studentGroup.StudentId" 
                                       class="text-decoration-none student-profile-link fw-semibold" 
                                       data-student-id="@studentGroup.StudentId">
                                        <i class="fas fa-user-circle me-2 text-primary"></i>@studentGroup.StudentFullName
                                    </a>
                                </td>
                                <td>@studentGroup.StudentNumber</td>
                                <td>
                                    <span class="badge bg-secondary rounded-pill px-2 py-1">@studentGroup.SectionName</span>
                                </td>
                                <td>
                                    @{
                                        var totalActivities = studentGroup.ActivitiesByPeriod.SelectMany(p => p.Value).Count();
                                    }
                                    <span class="badge bg-primary rounded-pill px-2 py-1">@totalActivities</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center rounded-lg shadow-sm" role="alert">
            <i class="fas fa-info-circle me-2"></i> No student records found matching your criteria.
        </div>
    }

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            @{
                var prevDisabled = !Model.StudentGroups.HasPreviousPage ? "disabled" : "";
                var nextDisabled = !Model.StudentGroups.HasNextPage ? "disabled" : "";
            }
            <li class="page-item @prevDisabled">
                <a asp-action="Records"
                   asp-route-sortOrder="@Model.CurrentSort"
                   asp-route-pageNumber="@(Model.StudentGroups.PageIndex - 1)"
                   asp-route-searchString="@Model.CurrentSearch"
                   asp-route-sectionId="@Model.CurrentSectionId"
                   asp-route-period="@Model.CurrentPeriod"
                   class="page-link rounded-pill mx-1">
                    Previous
                </a>
            </li>
            <li class="page-item @nextDisabled">
                <a asp-action="Records"
                   asp-route-sortOrder="@Model.CurrentSort"
                   asp-route-pageNumber="@(Model.StudentGroups.PageIndex + 1)"
                   asp-route-searchString="@Model.CurrentSearch"
                   asp-route-sectionId="@Model.CurrentSectionId"
                   asp-route-period="@Model.CurrentPeriod"
                   class="page-link rounded-pill mx-1">
                    Next
                </a>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <style>
        .clickable-row:hover {
            background-color: #f8f9fa;
        }
        
        .student-profile-link:hover {
            color: #0d6efd !important;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Make entire table rows clickable
            document.querySelectorAll('.clickable-row').forEach(row => {
                row.addEventListener('click', function(e) {
                    // Only trigger if the click wasn't on a link
                    if (e.target.tagName !== 'A' && !e.target.closest('a')) {
                        const link = this.querySelector('.student-profile-link');
                        if (link) {
                            window.location.href = link.href;
                        }
                    }
                });
            });
        });
    </script>
}
