@model IEnumerable<GradeRecordViewModel>

@{
    ViewData["Title"] = "Uploaded Grade Data";
}

<div class="container mt-5">
    <div class="card shadow-md mb-4 rounded-lg">
        <div class="card-header bg-primary text-white text-center py-2 rounded-top-lg">
            <h4 class="mb-0"><i class="fas fa-file-import me-2"></i> Uploaded Gradebook Data Preview</h4>
        </div>
        <div class="card-body p-4">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th data-bs-toggle="tooltip" title="Student's Last Name">Last Name</th>
                                <th data-bs-toggle="tooltip" title="Student's First Name">First Name</th>
                                <th data-bs-toggle="tooltip" title="Registered Email Address">Email</th>
                                <th data-bs-toggle="tooltip" title="Activity or assignment name">Activity Name</th>
                                <th data-bs-toggle="tooltip" title="Completion status">Status</th>
                                <th data-bs-toggle="tooltip" title="Score obtained">Points</th>
                                <th data-bs-toggle="tooltip" title="Maximum possible score">Max Points</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.LastName</td>
                                    <td>@item.FirstName</td>
                                    <td>@item.Email</td>
                                    <td>@item.ActivityName</td>
                                    <td>@item.Status</td>
                                    <td>@item.Points</td>
                                    <td>@item.MaxPoints</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center rounded-md" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> No data was found in the uploaded file, or the file format was incorrect.
                </div>
            }

            <div class="mt-4 text-center">
                <a asp-action="Index" class="btn btn-secondary rounded-pill px-3 shadow-sm"
                   data-bs-toggle="tooltip" title="Go back and upload a new CSV file">
                    <i class="fas fa-upload me-2"></i> Upload Another File
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/views/preview.js"></script>
}
